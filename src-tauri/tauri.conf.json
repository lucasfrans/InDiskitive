{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InDiskitive",
  "version": "0.1.1",
  "identifier": "app.indiskitive.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "InDiskitive",
        "width": 1320,
        "height": 820,
        "minWidth": 860,
        "minHeight": 540,
        "backgroundColor": "#0d0f13"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "publisher": "Lucas Fransen",
    "copyright": "Copyright 2026 Lucas Fransen",
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}

